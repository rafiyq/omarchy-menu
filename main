#!/bin/bash
# Main entry point for wmenu (omarchy-menu)
# Launches walker --provider menus:top-level when walker and display are available.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"

# Determine whether we have a GUI environment and walker
has_walker() {
    command -v walker >/dev/null 2>&1
}

has_display() {
    [[ -n "${DISPLAY:-}" ]] || [[ -n "${WAYLAND_DISPLAY:-}" ]]
}

# If walker and display exist, launch Elephant/Walker with top-level provider
if has_walker && has_display; then
    walker --provider menus:top-level "$@"
    exit 0
fi

# No walker or no display — show error and exit
# (TUI fallback lives on the 'tui' branch)
echo "Error: Walker is not available and display is missing." >&2
echo "If you need TTY support, check out the 'tui' branch." >&2
exit 1

# Otherwise fall back to bash TUI (keeps existing behaviour)
show_main_menu() {
    local choice
    choice=$(menu "Go" "$(printf '%s' 'Apps
Trigger
Style
Setup
Install
Remove
Update
About
System')")
    go_to_menu "$choice"
}

# Direct submenu jump via argument (backward compat)
if [[ ${#@} -gt 0 ]]; then
    BACK_TO_EXIT=true
    go_to_menu "$1"
else
    show_main_menu
fi
