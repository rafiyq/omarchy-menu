#!/bin/bash
# Main entry point for wmenu (omarchy-menu)
# Detects walker and display; falls back to lib/tui.sh if unavailable.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"

# Source remaining library files (for bash TUI fallback)
source "$SCRIPT_DIR/lib/platform.sh"
source "$SCRIPT_DIR/lib/pkg.sh"
source "$SCRIPT_DIR/lib/wm.sh"
source "$SCRIPT_DIR/lib/capture.sh"
source "$SCRIPT_DIR/lib/services.sh"
source "$SCRIPT_DIR/lib/core.sh"
source "$SCRIPT_DIR/lib/tui.sh"
source "$SCRIPT_DIR/lib/menu.sh"
source "$SCRIPT_DIR/lib/extensions.sh"

# Determine whether we have a GUI environment and walker
toggle_existing_menu

has_walker() {
    command -v walker >/dev/null 2>&1
}

has_display() {
    [[ -n "${DISPLAY:-}" ]] || [[ -n "${WAYLAND_DISPLAY:-}" ]]
}

# If walker and display exist, launch Elephant/Walker with top-level provider
if has_walker && has_display; then
    walker --provider menus:top-level "$@"
    exit 0
fi

# Otherwise fall back to bash TUI (keeps existing behaviour)
show_main_menu() {
    local choice
    choice=$(menu "Go" "$(printf '%s' 'Apps
Trigger
Style
Setup
Install
Remove
Update
About
System')")
    go_to_menu "$choice"
}

# Direct submenu jump via argument (backward compat)
if [[ ${#@} -gt 0 ]]; then
    BACK_TO_EXIT=true
    go_to_menu "$1"
else
    show_main_menu
fi
